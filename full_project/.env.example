# =========================================================
# Telecom Tower Fault Detection System - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =========================================================

# ── Database ──────────────────────────────────────────────
# Full PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/telecom_iot

# ── JWT Authentication ─────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-secret-key-minimum-32-chars
JWT_EXPIRE_MINUTES=60

# ── Admin Panel Access ─────────────────────────────────────
# Static token used to authenticate admin API calls
ADMIN_TOKEN=replace-with-a-strong-admin-token

# ── MQTT Broker ────────────────────────────────────────────
MOSQUITTO_HOST=trolley.proxy.rlwy.net
MOSQUITTO_PORT=26703
MOSQUITTO_USERNAME=fault-monitoring-system
MOSQUITTO_PASSWORD=di1u5ydet0z049vbbl08cofp6vhya45l

# ── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── ML Model ───────────────────────────────────────────────
# Path where the trained model file is stored
MODEL_PATH=model.oxxec

# ── Frontend (Next.js) ─────────────────────────────────────
# URL of the backend API (used at build time and runtime)
NEXT_PUBLIC_API_URL=http://localhost:8000
